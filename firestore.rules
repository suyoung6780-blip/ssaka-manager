rules_version = '2';

// 권한 요약
//  - 코치: 팀 콘텐츠 작성/수정, 일지검사, 상담 답변
//  - 선수: 팀 콘텐츠 열람, 본인 기록·목표·상담
//  - 다른 팀: 공개 팀의 선수단(members)만 열람, 비공개 팀은 팀 이름 외 열람 불가
//  - 스카우터: 우리 팀 코치끼리만 보는 찜 목록. U15→U12, U18→U15, U22→U18 선수만 (상대는 모름)
//  - 대화: 같은 팀원끼리, 또는 코치가 다른 팀 '팀 계정'(ownerUid)과만
//  - [무료 모드] 지도자가 팀을 만들 때 팀 · 팀 코드 · 대표 입장을 한 번에(같은 배치) 만들 수 있음
//    유료로 바꿀 때는 아래 '무료 모드' 표시된 줄을 지우면 결제(Cloud Functions)로만 활성화됨
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function teamDoc(t) { return get(/databases/$(database)/documents/teams/$(t)).data; }
    function memberPath(t) { return /databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid); }
    function isMember(t) { return signedIn() && exists(memberPath(t)); }
    function myRole(t) { return get(memberPath(t)).data.role; }
    function isCoach(t) { return isMember(t) && myRole(t) == 'coach'; }
    // 팀원(코치 · 선수). 팀 코드로 들어온 사람은 팀 대표가 승인(approved)한 뒤부터
    function isSquad(t) { return isMember(t) && myRole(t) in ['coach', 'player'] && get(memberPath(t)).data.get('approved', true) == true; }
    function isOwner(t) { return signedIn() && teamDoc(t).ownerUid == uid(); }
    function otherOf(p) { return p[0] == uid() ? p[1] : p[0]; }
    function teamPathOf(t) { return /databases/$(database)/documents/teams/$(t); }
    // 팀을 '지금 이 배치에서' 새로 만드는 대표 지도자인지
    function creatingTeam(t) { return !exists(teamPathOf(t)) && getAfter(teamPathOf(t)).data.ownerUid == uid(); }
    // 이용 가능: 베타 기간 무료 팀(free) · 새 팀 10일 체험(trial) · 운영자 무료 제공(기간 안, compUntil 없으면 평생) ·
    //           결제 기간 안(결제는 서버 /api/pay 만 기록)
    // 유료로 바꿀 때: free 줄에 '&& request.time < timestamp.date(전환일)' 을 붙이고, 아래 팀 만들기에서 free 를 빼기
    function teamUsable(t) { return teamDoc(t).get('free', false) == true
      || (teamDoc(t).get('trial', false) == true && request.time < teamDoc(t).createdAt + duration.value(10, 'd'))
      || (teamDoc(t).get('comp', false) == true && (teamDoc(t).get('compUntil', null) == null || teamDoc(t).compUntil > request.time))
      || teamDoc(t).get('paidUntil', timestamp.date(2000, 1, 1)) > request.time; }
    // 서비스 운영자 — public/js/config.js 의 ADMIN_EMAILS 와 같아야 함. 이메일 인증까지 마친 계정만
    function isAdmin() { return signedIn() && request.auth.token.email in ['suyoung6780@gmail.com']
      && request.auth.token.email_verified == true; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /users/{userId} {
      allow read: if (signedIn() && uid() == userId) || isAdmin(); // 운영자: 가입자 수 확인
      // 가입: 보호자 동의 완료 상태로 스스로 만들 수 없음
      // 새 개인계정은 이메일 인증을 마친 뒤에만 (임의 이메일 가입 방지)
      allow create: if signedIn() && uid() == userId && request.auth.token.email_verified == true
        && request.resource.data.get('guardianOk', false) != true;
      // 계정 유형 · 나이 · 동의 링크는 가입 후 변경 불가. 보호자 동의(guardianOk)는 보호자가 링크에서 동의한 뒤에만 켤 수 있음
      allow update: if signedIn() && uid() == userId
        && !changed().hasAny(['role', 'under14', 'birth', 'consentToken'])
        && (!changed().hasAny(['guardianOk']) || (request.resource.data.guardianOk == true
          && get(/databases/$(database)/documents/consents/$(resource.data.consentToken)).data.status == 'agreed'
          && get(/databases/$(database)/documents/consents/$(resource.data.consentToken)).data.uid == uid()));
      allow delete: if (signedIn() && uid() == userId) || isAdmin(); // 회원 탈퇴 · 운영자 내보내기
      // 이적: 보내는 팀 대표가 그 사람의 소속 팀을 받는 팀으로 바꿈
      allow update: if signedIn() && userId != uid() && changed().hasOnly(['teamId'])
        && getAfter(/databases/$(database)/documents/transfers/$(userId)).data.toTeam == request.resource.data.teamId
        && getAfter(/databases/$(database)/documents/transfers/$(userId)).data.fromTeam == resource.data.teamId
        && isOwner(resource.data.teamId);
      // 팀 대표: 우리 팀원이 잘못 고른 계정 유형 바로잡기 (선수 ↔ 지도자)
      allow update: if signedIn() && userId != uid() && changed().hasOnly(['role']) && request.resource.data.role in ['coach', 'player']
        && resource.data.get('teamId', '') != '' && isOwner(resource.data.teamId)
        && exists(/databases/$(database)/documents/teams/$(resource.data.teamId)/members/$(userId));

      // 홈 '오늘 할 일' 메모장 (본인만)
      match /todos/{todoId} {
        allow read, write: if signedIn() && uid() == userId;
        allow read, delete: if isAdmin(); // 운영자 내보내기
      }
      // 코치 노트 — 본인만 (팀 코치 · 선수 못 봄)
      match /notes/{noteId} {
        allow read, write: if signedIn() && uid() == userId;
        allow read, delete: if isAdmin(); // 운영자 내보내기 · 탈퇴 정리
      }
    }

    // 팀 코드 → teamId. 코드를 정확히 알 때만 조회 가능 (목록 조회 불가)
    match /teamCodes/{code} {
      allow get: if signedIn();
      // 무료 모드: 새 팀을 만드는 지도자만, 10자리 영문 · 숫자, 이미 있는 코드는 덮어쓸 수 없음(create만)
      allow create: if signedIn() && code.matches('^[A-Za-z0-9]{10}$')
        && request.resource.data.keys().hasOnly(['teamId', 'createdAt'])
        && (creatingTeam(request.resource.data.teamId) || isAdmin());
    }

    // 결제 기록 — 서버(/api/pay)만 씀. 결제한 팀 대표 본인과 운영자만 읽음
    match /payments/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == uid());
    }

    match /teams/{t} {
      allow read: if signedIn();

      // 스카웃 노트 — 우리 팀 코치만 읽고 씀 (이름 · 소속 · 장단점 · 확정/보류). 다른 팀에는 아무것도 기록되지 않음
      match /scouts/{noteId} {
        allow read, create, update, delete: if isCoach(t);
      }
      // 새 팀: 베타 기간엔 무료(free) · 유료 전환 뒤엔 10일 체험(trial). 만든 시각 = 서버 시각, 결제 · 무료 제공 표시는 스스로 못 넣음
      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && !request.resource.data.keys().hasAny(['paidUntil', 'comp', 'compUntil', 'plan', 'planCycle', 'lastPaidAt'])
        && request.resource.data.createdAt == request.time
        && (request.resource.data.status == 'pending'
          || (request.resource.data.status == 'active' && (request.resource.data.get('trial', false) == true || request.resource.data.get('free', false) == true)));
      allow update: if isOwner(t) && changed().hasOnly(['name', 'category', 'isPublic', 'intro']);
      // 대표 넘기기: 지금 대표가 우리 팀의 승인된 지도자에게만
      allow update: if isOwner(t) && changed().hasOnly(['ownerUid', 'ownerName'])
        && get(/databases/$(database)/documents/teams/$(t)/members/$(request.resource.data.ownerUid)).data.role == 'coach'
        && get(/databases/$(database)/documents/teams/$(t)/members/$(request.resource.data.ownerUid)).data.get('approved', true) != false;
      // 운영자: 홍보용 무료 제공(comp) 지정 · 해제 — 결제와 상관없이 계속 이용
      // 운영자: 팀 구분 정리 · 팀 이름 주의 · 기능 제한
      allow update: if isAdmin() && changed().hasOnly(['category', 'nameWarn', 'restricted', 'restrictedAt', 'hidden']); // hidden: 목록에서 숨기기 (심사 · 시험용 팀)
      allow update: if isAdmin() && changed().hasOnly(['comp', 'compMonths', 'compUntil', 'compBy', 'compAt', 'status']);

      match /members/{m} {
        allow read: if isMember(t) || isAdmin(); // 다른 팀 선수단은 못 봄 (공개 · 비공개 없음)
        allow create: if signedIn() && m == uid()
          && request.resource.data.role == get(/databases/$(database)/documents/users/$(uid())).data.role
          // 만 14세 미만은 보호자 동의 뒤에만 팀 입장
          && (get(/databases/$(database)/documents/users/$(uid())).data.get('under14', false) != true
            || get(/databases/$(database)/documents/users/$(uid())).data.get('guardianOk', false) == true)
          && (
            // 무료 모드: 팀을 만드는 대표 지도자
            (creatingTeam(t) && request.resource.data.role == 'coach')
            || (teamUsable(t) && (isOwner(t)
              || (get(/databases/$(database)/documents/teamCodes/$(request.resource.data.code)).data.teamId == t
                && request.resource.data.approved == false))) // 코드로 들어오면 승인 대기
          );
        // 본인은 역할 · 승인 · 나이 정보를 못 바꿈. 팀 대표는 승인 · 내보내기 가능
        allow update: if (signedIn() && m == uid() && !changed().hasAny(['role', 'code', 'under14', 'approved', 'approvedBy', 'approvedAt', 'consentToken'])) || isOwner(t);
        allow delete: if (signedIn() && m == uid()) || isOwner(t) || isAdmin();
        // 이적: 보내는 팀 대표가 받는 팀에 '승인 대기'로 넣음 (받는 팀 대표가 승인해야 들어감)
        allow create: if signedIn() && m != uid()
          && request.resource.data.approved == false
          && request.resource.data.role == get(/databases/$(database)/documents/users/$(m)).data.role
          && getAfter(/databases/$(database)/documents/transfers/$(m)).data.toTeam == t
          && isOwner(getAfter(/databases/$(database)/documents/transfers/$(m)).data.fromTeam)
          && exists(/databases/$(database)/documents/teams/$(getAfter(/databases/$(database)/documents/transfers/$(m)).data.fromTeam)/members/$(m));
      }

      match /private/{d} {
        allow read: if (d == 'gameModel' && isSquad(t)) || (d == 'billing' && (isCoach(t) || isAdmin()));
        // 운영자: 코드가 없는 팀(유료 모드의 결제 대기 팀)에 무료 제공하면서 코드 발급
        allow create: if d == 'billing' && isAdmin() && !exists(/databases/$(database)/documents/teams/$(t)/private/billing);
        allow write: if d == 'gameModel' && isCoach(t);
        // 무료 모드: 팀 만들 때 팀 코드 보관
        allow create: if d == 'billing' && creatingTeam(t)
          && getAfter(/databases/$(database)/documents/teamCodes/$(request.resource.data.code)).data.teamId == t;
      }

      match /posts/{p} {
        allow read: if isSquad(t);
        allow create, update: if isCoach(t)
          && request.resource.data.type in ['training', 'daily', 'meeting', 'analysis', 'notice', 'schedule'];
        allow delete: if isCoach(t);
      }

      // 훈련장 > 코치 훈련 정리 (코치만)
      match /coachNotes/{n} {
        allow read, write: if isCoach(t);
      }

      match /matches/{x} {
        allow read: if isSquad(t);
        allow write: if isCoach(t);
      }

      match /goals/{g} {
        allow read: if isSquad(t);
        allow create: if isSquad(t) && request.resource.data.ownerUid == uid() && (
          (request.resource.data.scope == 'team' && isCoach(t)) || request.resource.data.scope == 'personal');
        allow update, delete: if isCoach(t) || (isSquad(t) && resource.data.ownerUid == uid());
        allow list, delete: if isAdmin(); // 운영자 내보내기
      }

      // 일일 기록: 문서 ID = {uid}_{YYYY-MM-DD}
      match /logs/{l} {
        allow get: if isCoach(t) || (isMember(t) && l.split('_')[0] == uid());
        allow list: if isCoach(t) || (isMember(t) && resource.data.uid == uid()) || isAdmin(); // 운영자: 내보내기 때 지울 일지 찾기
        allow create: if isSquad(t) && request.resource.data.uid == uid()
          && l == uid() + '_' + request.resource.data.date;
        allow update: if (isSquad(t) && resource.data.uid == uid() && request.resource.data.uid == uid()
            && !changed().hasAny(['checked', 'coachComment', 'checkedBy', 'checkedAt', 'answers']))
          || (isCoach(t) && changed().hasOnly(['checked', 'coachComment', 'checkedBy', 'checkedAt', 'answers'])); // answers: 세션별 질문 답변
        allow delete: if (isMember(t) && resource.data.uid == uid()) || isAdmin(); // 회원 탈퇴 · 운영자 내보내기 때 일지 삭제
      }

      // 시제품 3.0 — IDP (선수 자기평가 → 코치 확정). 문서 ID = {uid}_{YYYY-MM}
      //  선수: 확정 전까지 자기 답만 · 코치 칸(coach)은 못 씀 / 코치: coach · 상태만, 원래 답(answers)은 못 고침
      //  코치가 확정할 때마다 rev 가 1씩 늘고, 같은 번호의 바꾼 기록(history)이 함께 있어야 함 · 지우기는 운영자만
      match /idp/{d} {
        allow get: if isCoach(t) || (isMember(t) && d.split('_')[0] == uid());
        allow list: if isCoach(t) || (isMember(t) && resource.data.uid == uid());
        allow create: if isSquad(t) && !isCoach(t) && request.resource.data.uid == uid()
          && d == uid() + '_' + request.resource.data.month
          && request.resource.data.status in ['draft', 'submitted']
          && request.resource.data.get('rev', 0) == 0
          && !request.resource.data.keys().hasAny(['coach', 'confirmedBy', 'confirmedByName', 'confirmedAt']);
        allow update: if (isSquad(t) && !isCoach(t) && resource.data.uid == uid()
            && resource.data.status in ['draft', 'submitted']
            && request.resource.data.status in ['draft', 'submitted']
            && !changed().hasAny(['uid', 'month', 'tplVer', 'rev', 'coach', 'confirmedBy', 'confirmedByName', 'confirmedAt']))
          || (isCoach(t) && resource.data.status in ['submitted', 'confirmed']
            && changed().hasOnly(['coach', 'status', 'rev', 'confirmedBy', 'confirmedByName', 'confirmedAt'])
            && request.resource.data.status == 'confirmed' && request.resource.data.confirmedBy == uid()
            && request.resource.data.rev == resource.data.get('rev', 0) + 1
            && existsAfter(/databases/$(database)/documents/teams/$(t)/idp/$(d)/history/$(string(request.resource.data.rev))));
        allow delete: if isAdmin();
        match /history/{h} {
          allow read: if isCoach(t) || (isMember(t) && d.split('_')[0] == uid());
          allow create: if request.resource.data.by == uid()
            && (isCoach(t) || (isSquad(t) && d.split('_')[0] == uid() && request.resource.data.what == 'submit'));
          // update · delete 없음 = 고치거나 지울 수 없음
        }
      }
      // 시제품 3.0 — IDP 설정 (한 달에 묻는 양). 팀원이 읽고 코치만 바꿈
      match /idpConfig/{c} {
        allow read: if isSquad(t);
        allow write: if isCoach(t);
      }
      // 시제품 3.0 — 경기분석 작업 기록 (AI 후보 · 바꾼 기록 · 작업 시간). 분석 게시물(posts)은 선수도 읽으므로 따로, 코치만
      match /matchWork/{w} {
        allow read, write: if isCoach(t);
      }

      // 상담실은 없앰 — 남은 글은 운영자가 한 번에 지울 수 있게 (운영자 페이지)
      match /counsel/{c} {
        allow read: if isCoach(t) || (isMember(t) && resource.data.authorUid == uid()) || isAdmin();
        allow create: if isSquad(t) && request.resource.data.authorUid == uid();
        allow update: if (isCoach(t) || (isMember(t) && resource.data.authorUid == uid()))
          && changed().hasOnly(['status', 'updatedAt', 'lastBy']);
        allow delete: if (isMember(t) && resource.data.authorUid == uid()) || isAdmin();

        match /replies/{r} {
          allow delete: if isAdmin();
          allow read: if isCoach(t) || (isMember(t) && get(/databases/$(database)/documents/teams/$(t)/counsel/$(c)).data.authorUid == uid()) || isAdmin();
          allow create: if request.resource.data.uid == uid() && (isCoach(t)
            || (isMember(t) && get(/databases/$(database)/documents/teams/$(t)/counsel/$(c)).data.authorUid == uid()));
        }
      }
    }

    match /chats/{c} {
      allow read: if signedIn() && uid() in resource.data.participants;
      allow update: if signedIn() && uid() in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow create: if signedIn() && uid() in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && c == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && (
          // 같은 팀원끼리
          (request.resource.data.kind == 'member' && isMember(request.resource.data.teamId)
            && exists(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/members/$(otherOf(request.resource.data.participants))))
          // 코치 → 다른 팀의 팀 계정
          || (request.resource.data.kind == 'team' && isCoach(request.resource.data.fromTeamId)
            && teamDoc(request.resource.data.teamId).ownerUid == otherOf(request.resource.data.participants))
        );

      match /messages/{msg} {
        allow read: if signedIn() && uid() in get(/databases/$(database)/documents/chats/$(c)).data.participants;
        allow create: if signedIn() && request.resource.data.uid == uid()
          && uid() in get(/databases/$(database)/documents/chats/$(c)).data.participants;
      }
    }

    // 커뮤니티 — 다른 팀 지도자끼리. 지도자 계정만 읽고 씀 (선수 계정은 볼 수 없음)
    function isCoachUser() { return signedIn() && get(/databases/$(database)/documents/users/$(uid())).data.role == 'coach'; }
    // 이적 기록 (사람마다 마지막 한 건) — 보내는 팀 대표가 만들고, 두 팀 대표 · 본인 · 운영자가 봄
    match /transfers/{u} {
      allow read: if signedIn() && (uid() == u || isOwner(resource.data.fromTeam) || isOwner(resource.data.toTeam) || isAdmin());
      allow create, update: if signedIn() && u != uid() && request.resource.data.by == uid()
        && isOwner(request.resource.data.fromTeam)
        && exists(/databases/$(database)/documents/teams/$(request.resource.data.fromTeam)/members/$(u))
        && exists(/databases/$(database)/documents/teams/$(request.resource.data.toTeam));
    }

    match /community/{p} {
      allow read: if isCoachUser() || isAdmin();
      allow create: if isCoachUser() && request.resource.data.authorUid == uid()
        && isCoach(request.resource.data.teamId) && request.resource.data.get('commentN', 0) == 0
        && teamDoc(request.resource.data.teamId).get('restricted', false) != true; // 기능 제한된 팀은 못 올림
      allow update: if (signedIn() && resource.data.authorUid == uid() && !changed().hasAny(['authorUid', 'teamId', 'teamName', 'createdAt']))
        || (isCoachUser() && changed().hasOnly(['commentN', 'lastAt']));
      allow delete: if (signedIn() && resource.data.authorUid == uid()) || isAdmin();
      match /comments/{c} {
        allow read: if isCoachUser() || isAdmin();
        allow create: if isCoachUser() && request.resource.data.uid == uid();
        allow delete: if (signedIn() && resource.data.uid == uid()) || isAdmin();
      }
    }

    // 운영자 문의 ① 팀 ↔ 운영자 대화방 (문서 id = 팀 id) — 그 팀 지도자와 운영자만
    match /support/{t} {
      allow read: if isCoach(t) || isAdmin();
      allow create, update: if (isCoach(t) || isAdmin()) && request.resource.data.teamId == t;
      match /messages/{m} {
        allow read: if isCoach(t) || isAdmin();
        allow create: if (isCoach(t) || isAdmin()) && request.resource.data.uid == uid()
          && request.resource.data.from == (isAdmin() ? 'admin' : 'team');
      }
    }
    // 운영자 문의 ② Q&A · 개선 제안 · 오류 신고 — 쓴 사람과 운영자만 봄, 답변 · 상태는 운영자만
    match /feedback/{f} {
      allow create: if signedIn() && request.resource.data.uid == uid()
        && request.resource.data.status == '접수' && !request.resource.data.keys().hasAny(['reply', 'repliedAt']);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == uid());
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == uid() && resource.data.status == '접수');
    }

    // 만 14세 미만 보호자 동의 — 링크(추측 불가능한 긴 토큰)를 아는 보호자가 로그인 없이 열어서 동의
    // 운영자가 내보낸 계정 안내: 문서 ID = 이메일 SHA-256 — 로그인 화면에서 이유를 보여 줌 (목록은 못 봄)
    match /expelled/{k} {
      allow get: if true;
      allow create, update, delete: if isAdmin();
      allow delete: if signedIn() && request.auth.token.email != null && request.auth.token.email.lower() == resource.data.email;
    }
    match /consents/{tk} {
      allow get: if true;
      allow create: if signedIn() && tk.size() >= 16 && request.resource.data.uid == uid()
        && request.resource.data.status == 'pending' && request.resource.data.keys().hasOnly(['uid', 'childName', 'status', 'createdAt']);
      allow update: if resource.data.status == 'pending' && request.resource.data.status == 'agreed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'guardianName', 'relation', 'phone', 'agreedAt', 'ver'])
        && request.resource.data.guardianName is string && request.resource.data.guardianName.size() > 0
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 10;
      allow delete: if (signedIn() && resource.data.uid == uid()) || isAdmin();
    }

    // 운영자 전체 공지 — 로그인한 모두가 읽고, 운영자만 씀
    match /system/{d} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 결제 기록은 서버 전용
    match /payments/{id} {
      allow read, write: if false;
    }
  }
}
